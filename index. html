<script>

/* FIRST PAGE FLOWERS */

const garden = document.getElementById("garden");

const flowerFragment = document.createDocumentFragment();

for (let i = 0; i < 13; i++) {
  const flower = document.createElement("div");
  flower.className = "flower";

  flower.style.setProperty(
    "--stem",
    (90 + Math.random() * 130) + "px"
  );

  flower.innerHTML = `
    <div class="bloom" style="--delay:${0.5 + Math.random()}s">
      <span class="petal"></span>
      <span class="petal"></span>
      <span class="petal"></span>
      <span class="petal"></span>
      <span class="petal"></span>
      <span class="flowerCenter"></span>
    </div>
    <div class="leaf left"></div>
    <div class="leaf right"></div>
  `;

  flowerFragment.appendChild(flower);
}

garden.appendChild(flowerFragment);

/* FLOATING HEARTS */

let effectsRunning = true;
let heartTimer = null;
let sparkleTimer = null;

function createFloatingHeart() {
  if (!effectsRunning || document.hidden) return;

  const heart = document.createElement("div");
  heart.className = "floating-heart";
  heart.textContent = Math.random() > .5 ? "♥" : "♡";
  heart.style.left = Math.random() * 100 + "vw";
  heart.style.bottom = "-35px";
  heart.style.fontSize = (22 + Math.random() * 22) + "px";
  heart.style.animationDuration = (9 + Math.random() * 6) + "s";

  document.body.appendChild(heart);

  heart.addEventListener("animationend", () => heart.remove(), {
    once: true
  });
}

function createSparkle() {
  if (!effectsRunning || document.hidden) return;

  const sparkle = document.createElement("div");
  sparkle.className = "sparkle";
  sparkle.style.left = Math.random() * 100 + "vw";
  sparkle.style.top = Math.random() * 100 + "vh";

  document.body.appendChild(sparkle);

  sparkle.addEventListener("animationend", () => sparkle.remove(), {
    once: true
  });
}

heartTimer = setInterval(createFloatingHeart, 1800);
sparkleTimer = setInterval(createSparkle, 1700);

/* PAUSE BACKGROUND EFFECTS WHEN TAB IS HIDDEN */

document.addEventListener("visibilitychange", () => {
  if (document.hidden) {
    effectsRunning = false;
  } else if (!started) {
    effectsRunning = true;
  }
});

/* ORIGINAL SOFT SYNTH MUSIC */

let audioContext = null;
let masterGain = null;
let musicTimer = null;
let musicOn = false;
let noteIndex = 0;

const melody = [
  523.25, 659.25, 783.99, 659.25,
  587.33, 698.46, 880.00, 698.46,
  523.25, 659.25, 783.99, 1046.50,
  880.00, 783.99, 659.25, 587.33
];

function playNote(frequency, time, duration, volume) {
  if (!audioContext || !masterGain) return;

  const osc = audioContext.createOscillator();
  const gain = audioContext.createGain();

  osc.type = "sine";
  osc.frequency.value = frequency;

  gain.gain.setValueAtTime(0.0001, time);
  gain.gain.exponentialRampToValueAtTime(volume, time + .12);
  gain.gain.exponentialRampToValueAtTime(.0001, time + duration);

  osc.connect(gain);
  gain.connect(masterGain);

  osc.start(time);
  osc.stop(time + duration + .05);
}

function musicStep() {
  if (!audioContext || !musicOn) return;

  const now = audioContext.currentTime;
  const note = melody[noteIndex % melody.length];

  playNote(note, now, 1.3, .07);

  if (noteIndex % 4 === 0) {
    playNote(note / 2, now, 2, .025);
  }

  noteIndex++;
}

async function startMusic() {
  const AudioClass = window.AudioContext || window.webkitAudioContext;
  if (!AudioClass) return false;

  if (!audioContext) {
    audioContext = new AudioClass();
    masterGain = audioContext.createGain();
    masterGain.gain.value = 0;
    masterGain.connect(audioContext.destination);
  }

  try {
    if (audioContext.state === "suspended") {
      await audioContext.resume();
    }

    if (audioContext.state !== "running") return false;

    musicOn = true;

    masterGain.gain.setTargetAtTime(
      .5,
      audioContext.currentTime,
      .3
    );

    if (musicTimer) clearInterval(musicTimer);

    musicStep();
    musicTimer = setInterval(musicStep, 650);

    document.getElementById("musicButton").textContent = "♫ Music: ON";
    return true;

  } catch (error) {
    return false;
  }
}

function stopMusic() {
  musicOn = false;

  if (musicTimer) {
    clearInterval(musicTimer);
    musicTimer = null;
  }

  if (masterGain && audioContext) {
    masterGain.gain.setTargetAtTime(
      0,
      audioContext.currentTime,
      .15
    );
  }

  document.getElementById("musicButton").textContent = "♫ Music: OFF";
}

document.getElementById("musicButton").addEventListener("click", async () => {
  if (musicOn) {
    stopMusic();
  } else {
    const success = await startMusic();

    if (!success) {
      document.getElementById("musicButton").textContent = "♫ Tap again";
    }
  }
});

/* PETAL EXPLOSION */

function createBloomBurst(x, y) {
  const fragment = document.createDocumentFragment();

  for (let i = 0; i < 35; i++) {
    const petal = document.createElement("span");
    petal.className = "burst-petal";

    const angle = Math.random() * Math.PI * 2;
    const distance = 70 + Math.random() * 130;

    petal.style.left = x + "px";
    petal.style.top = y + "px";

    petal.style.setProperty(
      "--moveX",
      Math.cos(angle) * distance + "px"
    );

    petal.style.setProperty(
      "--moveY",
      Math.sin(angle) * distance + "px"
    );

    petal.style.setProperty(
      "--rotation",
      Math.random() * 720 + "deg"
    );

    fragment.appendChild(petal);

    petal.addEventListener("animationend", () => petal.remove(), {
      once: true
    });
  }

  document.body.appendChild(fragment);
}

/* SCENE TRANSITION */

const gardenScene = document.getElementById("gardenScene");
const treeScene = document.getElementById("treeScene");

let started = false;

document.getElementById("startButton").addEventListener("click", async event => {
  if (started) return;
  started = true;

  await startMusic();

  const rect = event.currentTarget.getBoundingClientRect();

  createBloomBurst(
    rect.left + rect.width / 2,
    rect.top + rect.height / 2
  );

  setTimeout(() => {
    effectsRunning = false;

    clearInterval(heartTimer);
    clearInterval(sparkleTimer);

    gardenScene.classList.add("hidden");
    treeScene.classList.remove("hidden");

    setTimeout(startTreeAnimation, 500);
  }, 700);
});

/* HEART-SHAPED BOUQUET */

const canvas = document.getElementById("treeCanvas");
const ctx = canvas.getContext("2d", { alpha: true });

let W, H, dpr;
let flowers = [];
let animationStarted = false;
let lastProgress = 0;

function resizeCanvas() {
  dpr = Math.min(window.devicePixelRatio || 1, 1.5);

  W = window.innerWidth;
  H = window.innerHeight;

  canvas.width = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);

  canvas.style.width = W + "px";
  canvas.style.height = H + "px";

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  if (animationStarted) {
    createBouquet();
    drawBouquet(lastProgress);
  }
}

window.addEventListener("resize", resizeCanvas, { passive: true });
resizeCanvas();

/* HEART SHAPE */

function insideHeart(x, y) {
  const a = x * x + y * y - 1;
  return a * a * a - x * x * y * y * y <= 0;
}

function heartPosition(x, y) {
  const scaleX = Math.min(W * .40, 175);
  const scaleY = Math.min(H * .16, 155);

  return {
    x: W / 2 + x * scaleX,
    y: H * .45 - y * scaleY
  };
}

/* CREATE FLOWER BOUQUET */

function createBouquet() {
  flowers = [];

  let attempts = 0;

  while (flowers.length < 230 && attempts < 18000) {
    attempts++;

    const x = Math.random() * 2.5 - 1.25;
    const y = Math.random() * 2.5 - 1.25;

    if (!insideHeart(x, y)) continue;

    const p = heartPosition(x, y);

    flowers.push({
      x: p.x,
      y: p.y,
      size: 3.5 + Math.random() * 2.5,
      delay: Math.random() * .5,
      color: [
        "#ffffff",
        "#e8f3ff",
        "#d5e9ff",
        "#c1ddff",
        "#a9cefa",
        "#91bdf2",
        "#80afe9"
      ][Math.floor(Math.random() * 7)]
    });
  }
}

/* BOUQUET STEMS */

function drawStems(progress) {
  const amount = Math.max(0, Math.min(1, progress));

  const tieX = W / 2;
  const tieY = H * .73;
  const bottomY = H * .98;

  ctx.save();

  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  ctx.shadowColor = "#8fc5ff";
  ctx.shadowBlur = 5;

  flowers.forEach((f, i) => {
    const startAmount = Math.max(
      0,
      Math.min(1, (amount - .05) / .65)
    );

    if (startAmount <= 0) return;

    const endX = tieX + (f.x - tieX) * startAmount;
    const endY = tieY + (f.y - tieY) * startAmount;

    ctx.beginPath();
    ctx.moveTo(tieX, tieY);

    ctx.quadraticCurveTo(
      tieX + (endX - tieX) * .45,
      tieY + (endY - tieY) * .3,
      endX,
      endY
    );

    ctx.strokeStyle = "rgba(165, 204, 250, .48)";
    ctx.lineWidth = .65 + (i % 3) * .2;
    ctx.stroke();
  });

  for (let i = -7; i <= 7; i++) {
    ctx.beginPath();
    ctx.moveTo(tieX + i * .7, tieY);

    const endX = tieX + i * 4;
    const endY = tieY + (bottomY - tieY) * amount;

    ctx.quadraticCurveTo(
      tieX + i * 2,
      tieY + 65,
      endX,
      endY
    );

    ctx.strokeStyle = "rgba(165, 204, 250, .72)";
    ctx.lineWidth = 1.1;
    ctx.stroke();
  }

  ctx.restore();
}

/* FLOWER BLOOMS */

function drawFlower(f, progress) {
  const amount = Math.max(
    0,
    Math.min(1, (progress - .3 - f.delay * .35) / .4)
  );

  if (amount <= 0) return;

  ctx.save();

  ctx.translate(f.x, f.y);
  ctx.rotate((1 - amount) * .5);
  ctx.scale(amount, amount);

  ctx.shadowBlur = 5;
  ctx.shadowColor = f.color;

  for (let i = 0; i < 5; i++) {
    ctx.save();
    ctx.rotate(i * Math.PI * 2 / 5);

    ctx.beginPath();
    ctx.ellipse(
      0,
      -f.size * .78,
      f.size * .53,
      f.size,
      0,
      0,
      Math.PI * 2
    );

    ctx.fillStyle = f.color;
    ctx.fill();

    ctx.restore();
  }

  ctx.beginPath();
  ctx.arc(0, 0, f.size * .28, 0, Math.PI * 2);
  ctx.fillStyle = "#fff3ce";
  ctx.shadowBlur = 5;
  ctx.fill();

  ctx.restore();
}

/* BOUQUET RIBBON */

function drawRibbon(progress) {
  if (progress < .65) return;

  const amount = Math.min(1, (progress - .65) / .2);

  const x = W / 2;
  const y = H * .73;

  ctx.save();
  ctx.globalAlpha = amount;

  ctx.shadowColor = "#9bcaff";
  ctx.shadowBlur = 10;

  ctx.fillStyle = "#b5d8ff";

  ctx.beginPath();
  ctx.ellipse(x - 7, y, 9, 5, -.5, 0, Math.PI * 2);
  ctx.fill();

  ctx.beginPath();
  ctx.ellipse(x + 7, y, 9, 5, .5, 0, Math.PI * 2);
  ctx.fill();

  ctx.beginPath();
  ctx.arc(x, y, 4, 0, Math.PI * 2);
  ctx.fillStyle = "#e9f4ff";
  ctx.fill();

  ctx.beginPath();
  ctx.moveTo(x - 3, y + 3);
  ctx.quadraticCurveTo(x - 15, y + 18, x - 13, y + 28);
  ctx.lineTo(x - 2, y + 20);
  ctx.closePath();
  ctx.fillStyle = "#91bdf2";
  ctx.fill();

  ctx.beginPath();
  ctx.moveTo(x + 3, y + 3);
  ctx.quadraticCurveTo(x + 15, y + 18, x + 13, y + 28);
  ctx.lineTo(x + 2, y + 20);
  ctx.closePath();
  ctx.fill();

  ctx.restore();
}

/* BACKGROUND GLOW */

function drawGlow() {
  const glow = ctx.createRadialGradient(
    W / 2, H * .58, 5,
    W / 2, H * .58, W * .6
  );

  glow.addColorStop(0, "rgba(75, 135, 205, .23)");
  glow.addColorStop(1, "rgba(75, 135, 205, 0)");

  ctx.fillStyle = glow;
  ctx.fillRect(0, 0, W, H);
}

/* DRAW COMPLETE BOUQUET */

function drawBouquet(progress) {
  lastProgress = progress;

  ctx.clearRect(0, 0, W, H);

  drawGlow();
  drawStems(progress);

  flowers.forEach(f => {
    drawFlower(f, progress);
  });

  drawRibbon(progress);
}

/* BOUQUET GROWING ANIMATION */

function startTreeAnimation() {
  if (animationStarted) return;

  animationStarted = true;
  createBouquet();

  const duration = 11500;
  const start = performance.now();

  function animate(now) {
    const raw = Math.min((now - start) / duration, 1);

    const eased = raw < .5
      ? 4 * raw * raw * raw
      : 1 - Math.pow(-2 * raw + 2, 3) / 2;

    drawBouquet(eased);

    if (raw < 1) {
      requestAnimationFrame(animate);
    } else {
      showGreeting();
    }
  }

  requestAnimationFrame(animate);
}

/* GREETING */

function showGreeting() {
  document.getElementById("greeting").classList.add("show");

  setTimeout(() => {
    document.getElementById("letterButton").classList.add("show");
  }, 1800);
}

/* LETTER */

const letterScene = document.getElementById("letterScene");

document.getElementById("letterButton").addEventListener("click", () => {
  letterScene.classList.add("show");
});

document.getElementById("closeLetter").addEventListener("click", () => {
  letterScene.classList.remove("show");
});

</script>

