
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050b1b">
<title>For Ubrii ♡</title>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&amp;family=Great+Vibes&amp;display=swap" rel="stylesheet">
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #050b1b;
  color: #dceaff;
  font-family: 'Cormorant Garamond', serif;
  overflow: hidden;
}

.scene {
  position: fixed;
  inset: 0;
  overflow: hidden;
  transition: opacity 1.5s ease, visibility 1.5s ease;
}

.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

#gardenScene, #treeScene {
  background:
    radial-gradient(ellipse at 50% 85%, #173e70 0%, transparent 55%),
    radial-gradient(ellipse at 50% 35%, #142448 0%, transparent 65%),
    linear-gradient(180deg, #050817, #0b1530 65%, #071329);
}

/* STARS */

.stars {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(2px 2px at 15% 20%, #dceaff 80%, transparent),
    radial-gradient(2px 2px at 75% 15%, #8bb9f5 80%, transparent),
    radial-gradient(1px 1px at 45% 40%, white 80%, transparent),
    radial-gradient(2px 2px at 85% 55%, #a6caff 80%, transparent),
    radial-gradient(1px 1px at 25% 65%, white 80%, transparent);
  background-size: 250px 250px;
  opacity: .6;
  animation: starGlow 5s ease-in-out infinite alternate;
}

@keyframes starGlow {
  from { opacity: .3; }
  to { opacity: .8; }
}

/* INTRO */

.intro {
  position: absolute;
  top: 11%;
  width: 100%;
  text-align: center;
  padding: 0 12px;
  z-index: 5;
  animation: fadeUp 2s ease both;
}

.intro p, .greeting .small {
  font-size: 12px;
  letter-spacing: 5px;
  color: #a9c8ef;
  text-transform: uppercase;
}

.intro h1, .greeting h1 {
  font-family: 'Great Vibes', cursive;
  font-weight: 400;
  color: #d0e4ff;
  text-shadow: 0 0 25px #477fc5, 0 0 55px #315e9b;
}

.intro h1 {
  font-size: clamp(45px, 10vw, 75px);
  margin-top: 15px;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* FIRST FLOWER GARDEN */

.garden {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 43%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding: 0 4%;
}

.flower {
  position: relative;
  width: 5px;
  height: var(--stem);
  background: linear-gradient(#8eb39a, #294b46);
  border-radius: 10px;
  transform-origin: bottom;
  animation: growStem 2s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes growStem {
  from { transform: scaleY(0); }
  to { transform: scaleY(1); }
}

.bloom {
  position: absolute;
  width: 42px;
  height: 42px;
  top: -30px;
  left: 50%;
  transform: translateX(-50%) scale(0);
  animation: bloomIn 1.5s ease-out forwards;
  animation-delay: var(--delay);
  filter: drop-shadow(0 0 10px #77aaff);
}

.petal {
  position: absolute;
  width: 15px;
  height: 21px;
  left: 13.5px;
  top: 0;
  border-radius: 60% 60% 45% 45%;
  transform-origin: 50% 21px;
  background: linear-gradient(180deg, #e5f2ff, #82b3eb 75%, #416eae);
  box-shadow: 0 0 8px rgba(135,184,255,.5);
}

.petal:nth-child(1) { transform: rotate(0deg); }
.petal:nth-child(2) { transform: rotate(72deg); }
.petal:nth-child(3) { transform: rotate(144deg); }
.petal:nth-child(4) { transform: rotate(216deg); }
.petal:nth-child(5) { transform: rotate(288deg); }

.flowerCenter {
  position: absolute;
  width: 9px;
  height: 9px;
  left: 16.5px;
  top: 16px;
  border-radius: 50%;
  background: #fff2c4;
  box-shadow: 0 0 8px #fff2c4;
  z-index: 2;
}

@keyframes bloomIn {
  from { transform: translateX(-50%) scale(0) rotate(-40deg); }
  to { transform: translateX(-50%) scale(1) rotate(0); }
}

.leaf {
  position: absolute;
  width: 25px;
  height: 12px;
  background: #426b60;
  border-radius: 100% 0 100% 0;
  top: 55%;
}

.leaf.left {
  left: -22px;
  transform: rotate(15deg);
}

.leaf.right {
  right: -22px;
  transform: rotate(75deg) scaleX(-1);
}

/* TAP FLOWER */

.tap-flower {
  position: absolute;
  z-index: 10;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 82px;
  height: 82px;
  border: 1px solid #91b9ef;
  border-radius: 50%;
  background: rgba(18, 45, 86, .65);
  cursor: pointer;
  box-shadow: 0 0 25px #477fc5, inset 0 0 20px #315e9b;
  animation: pulse 2.5s infinite;
  display: grid;
  place-items: center;
}

.tap-flower .mini-flower {
  width: 42px;
  height: 42px;
  position: relative;
  filter: drop-shadow(0 0 8px #c3e1ff);
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 20px #477fc5; }
  50% { box-shadow: 0 0 45px #8bbdff, 0 0 75px #315e9b; }
}

.tap-text {
  position: absolute;
  top: calc(55% + 60px);
  width: 100%;
  text-align: center;
  color: #a9c8ef;
  letter-spacing: 4px;
  font-size: 13px;
  z-index: 10;
}

/* FLOATING EFFECTS */

.floating-heart {
  position: fixed;
  color: #a5caff;
  opacity: .55;
  animation: floatUp linear forwards;
  pointer-events: none;
  z-index: 3;
  text-shadow: 0 0 12px #77aaff;
  will-change: transform, opacity;
}

@keyframes floatUp {
  from {
    transform: translateY(0) rotate(0);
    opacity: 0;
  }
  20% { opacity: .65; }
  to {
    transform: translateY(-110vh) rotate(35deg);
    opacity: 0;
  }
}

.sparkle {
  position: fixed;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #e4f3ff;
  box-shadow: 0 0 9px 3px #82baff;
  pointer-events: none;
  animation: sparkle 3s ease-in-out infinite;
  z-index: 2;
  will-change: transform, opacity;
}

@keyframes sparkle {
  0%, 100% { opacity: 0; transform: scale(.3); }
  50% { opacity: 1; transform: scale(1.5); }
}

/* PETAL BURST */

.burst-petal {
  position: fixed;
  z-index: 50;
  width: 12px;
  height: 17px;
  border-radius: 60% 60% 45% 45%;
  background: linear-gradient(#f2f8ff, #82b7f2);
  pointer-events: none;
  box-shadow: 0 0 12px #a8d2ff;
  animation: petalBurst 1.5s ease-out forwards;
  will-change: transform, opacity;
}

@keyframes petalBurst {
  0% {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(.3);
  }
  100% {
    opacity: 0;
    transform: translate(var(--moveX), var(--moveY))
      rotate(var(--rotation)) scale(1.2);
  }
}

/* MUSIC */

.music-control {
  position: fixed;
  top: 18px;
  right: 15px;
  z-index: 30;
  border: 1px solid rgba(174, 207, 248, .5);
  background: rgba(9, 23, 49, .85);
  color: #dceaff;
  border-radius: 30px;
  padding: 9px 14px;
  font-family: inherit;
  font-size: 15px;
  letter-spacing: 1px;
  cursor: pointer;
  backdrop-filter: blur(8px);
}

/* BOUQUET SCENE */

#treeCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.greeting {
  position: absolute;
  top: 5%;
  width: 100%;
  text-align: center;
  padding: 0 10px;
  opacity: 0;
  transition: opacity 2.0s ease;
  z-index: 5;
  pointer-events: none;
}

.greeting.show { opacity: 1; }

.greeting h1 {
  font-size: clamp(43px, 10vw, 76px);
  line-height: 1.15;
  margin-top: 12px;
}

.greeting p {
  color: #c1d8f5;
  font-size: 15px;
  letter-spacing: 2px;
  margin-top: 8px;
}

/* LETTER BUTTON */

.letter-button {
  position: absolute;
  bottom: 7%;
  left: 50%;
  transform: translateX(-50%);
  border: 1px solid #9bbce8;
  color: #e0edff;
  background: rgba(18, 45, 86, .75);
  padding: 14px 30px;
  border-radius: 40px;
  font-family: inherit;
  font-size: 18px;
  letter-spacing: 3px;
  cursor: pointer;
  opacity: 0;
  transition: opacity 2s, background .3s, box-shadow .3s;
  z-index: 6;
  white-space: nowrap;
  box-shadow: 0 0 15px rgba(103, 157, 225, .15);
}

.letter-button.show { opacity: 1; }

.letter-button:hover {
  background: #244e83;
  box-shadow: 0 0 25px #477fc5;
}

/* LETTER */

#letterScene {
  position: fixed;
  inset: 0;
  z-index: 25;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 22px;
  background: rgba(3, 8, 20, .97);
  opacity: 0;
  visibility: hidden;
  transition: 1s;
}

#letterScene.show {
  opacity: 1;
  visibility: visible;
}

.letter {
  max-width: 520px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 35px 27px;
  border: 1px solid #658fc5;
  background: linear-gradient(145deg, #142b4c, #091326);
  box-shadow: 0 0 50px rgba(80, 140, 220, .2);
  text-align: center;
  animation: letterAppear 1s ease both;
}

@keyframes letterAppear {
  from { transform: translateY(20px) scale(.96); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

.letter h2 {
  font-family: 'Great Vibes', cursive;
  font-size: 48px;
  color: #c8e0ff;
  font-weight: 400;
  margin-bottom: 20px;
}

.letter p {
  font-size: 18px;
  line-height: 1.8;
  color: #dceaff;
  white-space: pre-line;
}

.close-button {
  margin-top: 25px;
  border: 1px solid #9bbce8;
  background: transparent;
  color: #e0edff;
  padding: 10px 25px;
  border-radius: 25px;
  font-family: inherit;
  font-size: 16px;
  cursor: pointer;
}

/* SMALL SCREENS */

@media (max-height: 700px) {
  .intro { top: 5%; }
  .garden { height: 38%; }
  .greeting { top: 3%; }
}

@media (max-width: 380px) {
  .greeting .small {
    font-size: 10px;
    letter-spacing: 3px;
  }

  .greeting h1 { font-size: 43px; }

  .greeting p { font-size: 13px; }

  .letter-button {
    font-size: 16px;
    padding: 12px 23px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .stars, .flower, .tap-flower {
    animation-duration: .01ms;
  }
}
</style>
</head>

<body>

<!-- FIRST SCENE -->

<section class="scene" id="gardenScene">
  <div class="stars"></div>

  <div class="intro">
    <p>A little something for you</p>
